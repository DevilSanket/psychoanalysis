# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=munmeet_db

# Frontend / IIS origin (e.g. http://localhost or http://myserver.example.com)
ALLOWED_ORIGIN=http://localhost

# Google Gemini (get from https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_google_api_key_here

# LangSmith (get from https://smith.langchain.com — enables pipeline tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=psycho-analysis-pipeline
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Admin Panel (simple password auth — change in production!)
ADMIN_PASSWORD=isfadmin
